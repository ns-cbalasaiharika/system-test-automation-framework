{
  "name": "system-test-automation-framework",
  "version": "1.0.0",
  "description": "Config-driven k6 performance testing framework for system testing",
  "type": "module",
  "scripts": {
    "bundle": "webpack --config webpack.config.js",
    "bundle:watch": "webpack --config webpack.config.js --watch",
    "bundle:all": "node scripts/bundle-all.js",
    "lint": "make lint",
    "test": "make run-smoke SCENARIO=bl01"
  },
  "devDependencies": {
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "copy-webpack-plugin": "^12.0.2",
    "glob": "^10.3.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "k6",
    "performance",
    "testing",
    "load-testing",
    "system-testing"
  ],
  "license": "MIT"
}
